[Unit]
Description=Washiviana - Articles Publish Worker (LinkedIn)
After=network.target

[Service]
Type=oneshot
User=washi
WorkingDirectory=/home/washi/washiviana-site
ExecStart=/usr/bin/php /home/washi/washiviana-site/scripts/worker_publish_articles.php
Nice=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
